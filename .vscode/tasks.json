{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Resume: build",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}/.venv/Scripts/python.exe" },
      "args": ["${workspaceFolder}/resume/scripts/build_resume.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Resume: watch",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}/.venv/Scripts/python.exe" },
      "args": ["${workspaceFolder}/resume/scripts/build_resume.py", "--watch"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
