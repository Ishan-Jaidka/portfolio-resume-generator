{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio presentation settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "resumeLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url",
        "resumeLabel"
      ]
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "portrait": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "src": {
              "type": "string",
              "pattern": "^/images/(?!.*\\.\\.)[a-zA-Z0-9_./-]+$"
            },
            "alt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "src",
            "alt"
          ]
        },
        "primaryAction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "section": {
              "enum": [
                "projects",
                "experience",
                "interests",
                "education"
              ]
            }
          },
          "required": [
            "label",
            "section"
          ]
        }
      },
      "required": [
        "eyebrow",
        "intro",
        "description",
        "portrait",
        "primaryAction"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accentHover": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "accent",
        "accentHover"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "projects",
              "experience",
              "interests",
              "education"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "navLabel": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "navLabel"
        ]
      }
    },
    "contacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showEmail": {
          "type": "boolean"
        },
        "showPhone": {
          "type": "boolean"
        },
        "showMiscellaneous": {
          "type": "boolean"
        },
        "links": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "showEmail",
        "showPhone",
        "showMiscellaneous",
        "links"
      ]
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previewBullets": {
          "type": "integer",
          "minimum": 0
        },
        "expandLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "previewBullets",
        "expandLabel"
      ]
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "illustration": {
            "enum": [
              "city",
              "calculator",
              "greenhouse"
            ]
          },
          "accent": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^/images/(?!.*\\.\\.)[a-zA-Z0-9_./-]+$"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "src",
              "alt"
            ]
          },
          "linkLabels": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": []
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showName": {
          "type": "boolean"
        }
      },
      "required": [
        "showName"
      ]
    }
  },
  "required": [
    "site",
    "hero",
    "theme",
    "sections",
    "contacts",
    "experience",
    "projects",
    "header"
  ]
}
