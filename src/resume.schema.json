{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaidka.dev/schemas/resume/1.0.0",
  "title": "Resume shared data model v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "const": "GENERATED by src/scripts/build_resume.py; edit resume-content/*.yaml, not this file."
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\]*$"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\]*$"
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\]*$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^[^\\\\]+$"
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linkedin": {
              "$ref": "#/$defs/profileLink"
            },
            "github": {
              "$ref": "#/$defs/profileLink"
            }
          },
          "required": [
            "linkedin",
            "github"
          ]
        },
        "miscellaneous": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\\\]*$"
            },
            "show": {
              "type": "boolean"
            }
          },
          "required": [
            "text",
            "show"
          ]
        }
      },
      "required": [
        "name",
        "address",
        "phone",
        "email",
        "miscellaneous",
        "links"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\]*$"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\\\]*$"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\\\]*$"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "items"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "label",
          "groups"
        ]
      },
      "minItems": 1
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\]*$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\]*$"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\]*$"
          },
          "startDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "minLength": 7,
            "maxLength": 7
          },
          "endDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                "minLength": 7,
                "maxLength": 7
              },
              {
                "type": "null"
              }
            ]
          },
          "bullets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/bullet"
            },
            "minItems": 1
          }
        },
        "required": [
          "company",
          "role",
          "location",
          "startDate",
          "endDate",
          "bullets"
        ]
      },
      "minItems": 0
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\]*$"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/link"
            },
            "minItems": 1
          },
          "description": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/run"
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "description"
        ]
      },
      "minItems": 0
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "degree": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\]*$"
          },
          "honors": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\\\]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "institution": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\]*$"
          },
          "startDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                "minLength": 7,
                "maxLength": 7
              },
              {
                "type": "null"
              }
            ]
          },
          "endDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                "minLength": 7,
                "maxLength": 7
              },
              {
                "type": "null"
              }
            ]
          },
          "gpa": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\\\]*$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional GPA display text, such as 3.8/4.0; null or omitted hides it."
          }
        },
        "required": [
          "degree",
          "institution",
          "startDate",
          "endDate"
        ]
      },
      "minItems": 0
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\\\]*$"
      },
      "minItems": 0
    }
  },
  "required": [
    "$comment",
    "schemaVersion",
    "profile",
    "skills",
    "experience",
    "projects",
    "education",
    "interests"
  ],
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\]*$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s\\\\{}]+$"
        }
      },
      "required": [
        "text",
        "url"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\]*$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s\\\\{}]+$"
        }
      },
      "required": [
        "text"
      ]
    },
    "bullet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          },
          "minItems": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bullet"
          },
          "minItems": 1
        }
      },
      "required": [
        "runs"
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^[A-Za-z]+$"
            }
          },
          "required": [
            "color"
          ]
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": {
              "type": "boolean"
            },
            "experience": {
              "type": "boolean"
            },
            "projects": {
              "type": "boolean"
            },
            "education": {
              "type": "boolean"
            },
            "interests": {
              "type": "boolean"
            }
          },
          "required": [
            "skills",
            "experience",
            "projects",
            "education",
            "interests"
          ]
        },
        "automation": {
          "type": "boolean"
        }
      },
      "required": [
        "theme",
        "sections",
        "automation"
      ]
    },
    "profileLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\]*$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s\\\\{}]+$"
        },
        "show": {
          "type": "boolean",
          "description": "Whether to display this link in the PDF header."
        }
      },
      "required": [
        "text",
        "url",
        "show"
      ]
    }
  }
}
